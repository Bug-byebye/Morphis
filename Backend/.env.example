# AI Generation Pipeline - 环境变量配置
# 复制此文件为 .env 并填入你的 API 密钥

# ========== ARK (火山引擎) ==========
ARK_API_KEY=your-ark-api-key-here
ARK_MODEL_T2I=your-text2image-endpoint-id

# ========== 可选配置 ==========
# ARK_MODEL_I2I=your-image2image-endpoint-id
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
