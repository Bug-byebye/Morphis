# AI Generation Pipeline - 环境变量配置
# 复制此文件为 .env 作为安全默认配置
# 再复制一份为 .env.local 填入你自己的私有密钥（不会提交到 git）

# ========== 数据库（必填：联机/世界快照依赖） ==========
# 未设置时默认使用本地：postgresql://postgres:postgres@localhost:5432/morphis
# 生产/联机请使用远程云 PostgreSQL，连接失败时服务将拒绝启动
#
# 阿里云 RDS PostgreSQL 示例（请替换 <用户名>、<密码>、<库名>）：
# 外网（非 VPC 内机器）：postgresql://<用户名>:<密码>@pgm-bp18b2zkp3d07pz8so.pg.rds.aliyuncs.com:5432/<库名>
# 内网（同 VPC）：       postgresql://<用户名>:<密码>@pgm-bp18b2zkp3d07pz8.pg.rds.aliyuncs.com:5432/<库名>
# 需在 RDS 控制台设置白名单（本机或服务器 IP）后再连接
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ========== ARK (火山引擎) ==========
ARK_API_KEY=
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828
ARK_IMAGE_EDIT_MODEL_ID=doubao-seedream-4-5-251128

# ========== 3D Provider ==========
# auto: 优先使用腾讯云混元 3D（凭证齐全时），否则回退到 Trellis
THREED_PROVIDER=auto

# 腾讯云混元生 3D 极速版（官方 ai3d API）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_AI3D_REGION=ap-guangzhou
TENCENT_AI3D_HOST=ai3d.tencentcloudapi.com
TENCENT_AI3D_VERSION=2025-05-13
TENCENT_AI3D_RESULT_FORMAT=GLB
TENCENT_AI3D_ENABLE_PBR=false
TENCENT_AI3D_ENABLE_GEOMETRY=false
TENCENT_AI3D_POLL_INTERVAL=5
TENCENT_AI3D_MAX_POLL_TIME=600

# 如果你手里只有 sk- 风格 key，它不能直接签名官方 ai3d 接口；
# 当前代码只把它作为提示变量保留。
TENCENT_HUNYUAN_API_KEY=

# Trellis（本地 3D 服务，作为回退）
TRELLIS_SERVER_URL=http://localhost:8001
TRELLIS_TIMEOUT=600

# ========== 可选配置 ==========
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# API_TIMEOUT=300
# DEFAULT_NUM_IMAGES=1
# DEFAULT_IMAGE_SIZE=1:1
# DEBUG_MODE=false
# OUTPUT_DIR=./output
# MODEL_DIR=./assets/models
# VOLC_ACCESSKEY=
# VOLC_SECRETKEY=
# IMGBB_API_KEY=

# ========== World 进程管理 ==========
# Unity Server 可执行文件路径
UNITY_SERVER_PATH=/home/morphis/MorphisServer/Morphis.x86_64

# 服务器公网 IP（客户端连接用）
SERVER_PUBLIC_IP=127.0.0.1

# Backend API URL（Unity Server 回调用）
API_BASE_URL=http://localhost:8000
