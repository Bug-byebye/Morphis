# 数据库配置
DATABASE_URL=postgresql://morphis_user:Morphis1234@localhost:5432/morphis_db

# 服务器配置
HOST=0.0.0.0
PORT=8000

# World 进程管理配置
UNITY_SERVER_PATH=/root/Morphis/MorphisServer/Morphis.x86_64
SERVER_PUBLIC_IP=34.143.226.137
API_BASE_URL=http://localhost:8000

# AI Generation Pipeline - ARK / 图像服务
ARK_API_KEY=
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828
ARK_IMAGE_EDIT_MODEL_ID=doubao-seedream-4-0-250828

# 3D provider
THREED_PROVIDER=auto
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_AI3D_REGION=ap-guangzhou
TENCENT_AI3D_HOST=ai3d.tencentcloudapi.com
TENCENT_AI3D_VERSION=2025-05-13
TENCENT_AI3D_RESULT_FORMAT=GLB
TENCENT_AI3D_ENABLE_PBR=false
TENCENT_AI3D_ENABLE_GEOMETRY=false
TENCENT_AI3D_POLL_INTERVAL=5
TENCENT_AI3D_MAX_POLL_TIME=600
TRELLIS_SERVER_URL=http://localhost:8001
TRELLIS_TIMEOUT=600

# API Timeout in seconds
API_TIMEOUT=300

# Default image generation settings
DEFAULT_NUM_IMAGES=1
DEFAULT_IMAGE_SIZE=1:1

# Debug mode (true/false)
DEBUG_MODE=false

# Output / model paths
OUTPUT_DIR=./output
MODEL_DIR=./assets/models

# Currently unused by Backend code, kept here for future integration
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
IMGBB_API_KEY=
