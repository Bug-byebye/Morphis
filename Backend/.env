# Morphis Backend 环境变量（与 deploy/server-config.json 对齐）
# 敏感密钥请写入 .env.local（不会被 git 跟踪）

# ========== 数据库（供文档/工具参考；运行时以 server-config.json 为准） ==========
DATABASE_URL=postgresql://MorphisServer:Morphis1234@localhost:5432/morphis-data

# ========== 服务监听 ==========
HOST=0.0.0.0
PORT=8000

# ========== World 进程管理 ==========
UNITY_SERVER_PATH=/srv/MorphisServer/Morphis.x86_64
SERVER_PUBLIC_IP=47.86.171.174
API_BASE_URL=http://47.86.171.174:8000

# ========== ARK (火山引擎) — 在 .env.local 填入真实密钥 ==========
ARK_API_KEY=
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828
ARK_IMAGE_EDIT_MODEL_ID=doubao-seedream-4-5-251128

# ========== 3D Provider ==========
THREED_PROVIDER=auto
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_AI3D_REGION=ap-guangzhou
TENCENT_AI3D_HOST=ai3d.tencentcloudapi.com
TENCENT_AI3D_VERSION=2025-05-13
TENCENT_AI3D_RESULT_FORMAT=GLB
TENCENT_AI3D_ENABLE_PBR=false
TENCENT_AI3D_ENABLE_GEOMETRY=false
TENCENT_AI3D_POLL_INTERVAL=5
TENCENT_AI3D_MAX_POLL_TIME=600
TRELLIS_SERVER_URL=http://localhost:8001
TRELLIS_TIMEOUT=600

# ========== 可选 ==========
API_TIMEOUT=300
DEFAULT_NUM_IMAGES=1
DEFAULT_IMAGE_SIZE=1:1
DEBUG_MODE=false
OUTPUT_DIR=./output
MODEL_DIR=./assets/models
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
IMGBB_API_KEY=
